{
  "name": "playwright-locator-analyses",
  "version": "0.2.0",
  "description": "Playwright reporter and linter that grades locator fragility (A–F) and ranks the tests most likely to break.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "playwright-locator-analyses": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "playwright",
    "reporter",
    "locator",
    "selector",
    "flaky",
    "lint",
    "playwright-reporter",
    "test-automation",
    "e2e",
    "xpath",
    "css-selector",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "example": "pnpm run build && playwright test --list -c example",
    "typecheck": "tsc -p tsconfig.check.json",
    "pretest": "pnpm run build",
    "e2e": "playwright test -c e2e",
    "e2e:verify": "node scripts/verify-e2e-report.mjs e2e/fragility-report.json",
    "docs:images": "pnpm run build && node scripts/screenshots.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.27"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0"
  },
  "author": "Laerte Mello",
  "homepage": "https://github.com/laerteneto/playwright-locator-analyses#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laerteneto/playwright-locator-analyses.git"
  },
  "bugs": {
    "url": "https://github.com/laerteneto/playwright-locator-analyses/issues"
  },
  "packageManager": "pnpm@11.20.0"
}
