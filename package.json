{
  "name": "playwright-locator-fragility",
  "version": "0.1.0",
  "description": "Playwright reporter + linter that scores locator fragility and ranks the tests most likely to break.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./reporter": "./dist/reporter.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "locator-fragility": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "playwright",
    "reporter",
    "locator",
    "selector",
    "flaky",
    "lint"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "example": "npm run build && playwright test --list -c example",
    "typecheck": "tsc -p tsconfig.check.json",
    "pretest": "npm run build",
    "e2e": "playwright test -c e2e",
    "e2e:verify": "node scripts/verify-e2e-report.mjs e2e/fragility-report.json",
    "docs:images": "npm run build && node scripts/screenshots.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.27"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0"
  }
}
